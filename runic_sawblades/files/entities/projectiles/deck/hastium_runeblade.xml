<Entity name="RUNICSAWBLADE_HASTIUM" tags="projectile_player,disc_bullet" >

	<Base file="data/entities/base_projectile.xml" >
		<VelocityComponent
			gravity_y="250"
			air_friction="0.6"
			mass="0.05"
			>
		</VelocityComponent>
	</Base>

    <VariableStorageComponent
        name="checked_for_material_change"
        value_bool="0"
    ></VariableStorageComponent>

    <VariableStorageComponent
        name="started_life_countdown"
        value_bool="0"
    ></VariableStorageComponent>

    <VariableStorageComponent
        name="number_of_frames_until_death"
        value_int="60"
    ></VariableStorageComponent>

    <VariableStorageComponent
        name="material_type"
        value_string="magic_liquid_movement_faster"
    ></VariableStorageComponent>

    <VariableStorageComponent
        name="added_material_per_hit"
        value_float="-0.001"
    ></VariableStorageComponent>

    <GameAreaEffectComponent
      radius="4"
      collide_with_tag="hittable"
      frame_length="5"
  ></GameAreaEffectComponent>

  <ProjectileComponent 
    _enabled="1" 
    lob_min="0.5"
    lob_max="0.7"
    speed_min="350"
    speed_max="450"
    friction="1"
    direction_random_rad="0.01"
    on_death_explode="0"
    on_death_gfx_leave_sprite="1" 
    on_lifetime_out_explode="0"
    explosion_dont_damage_shooter="1"
    on_collision_die="0"
    on_collision_remove_projectile="0"
    lifetime="360"
    damage="0"
    damage_scaled_by_speed="1"
    damage_every_x_frames="5"
    lifetime_randomness="7"
    ragdoll_force_multiplier="0"
    hit_particle_force_multiplier="0.1"
    create_shell_casing="0"
    muzzle_flash_file="data/entities/particles/muzzle_flashes/muzzle_flash_medium.xml"
    shoot_light_flash_r="255"
    shoot_light_flash_g="240"
    shoot_light_flash_b="30"
    shoot_light_flash_radius="64"
    die_on_low_velocity="0"
    die_on_low_velocity_limit="5"
    bounces_left="2"
    bounce_at_any_angle="1"
    collide_with_shooter_frames="6"
    friendly_fire="1"
    velocity_sets_rotation="1"
    velocity_updates_animation="1"
    velocity_sets_scale="0"
    ragdoll_fx_on_collision="BLOOD_EXPLOSION"
	knockback_force="1.3"
    physics_impulse_coeff="1500"
    >
	<damage_by_type
		slice="0.05"
		>
	</damage_by_type>
    <config_explosion>
    </config_explosion>
  </ProjectileComponent>

  <CollisionTriggerComponent
        width="18.0"
        height="18.0"
        radius="18.0"
        skip_self_frames="-1"
        destroy_this_entity_when_triggered="0"
    ></CollisionTriggerComponent>

    <LuaComponent
        script_collision_trigger_hit="mods/runic_sawblades/files/scripts/projectiles/rsb_proj_impact.lua"
        script_source_file="mods/runic_sawblades/files/scripts/projectiles/runic_sawblades_behavior.lua"
    ></LuaComponent>
  
  <SpriteComponent 
    _enabled="1" 
    alpha="1" 
    image_file="mods/runic_sawblades/files/projectiles_gfx/disc_bullet_hastium.xml" 
    next_rect_animation=""
    rect_animation="" 
     >
  </SpriteComponent>
  
  <SpriteParticleEmitterComponent
    sprite_file="mods/runic_sawblades/files/particles/discbullet_trail_hastium.xml"
    delay="0"
    lifetime="1"
	additive="1"
    color.r="1" color.g="1" color.b="1" color.a="1"
    color_change.r="0" color_change.g="0" color_change.b="0" color_change.a="-4"
    velocity.x="0" velocity.y="0"
    gravity.x="0" gravity.y="10"
    velocity_slowdown="0"
    rotation="0"
    angular_velocity="0"
    use_velocity_as_rotation="0"
    scale.x="1" scale.y="1"
    scale_velocity.x="0" scale_velocity.y="0"
    emission_interval_min_frames="5"
    emission_interval_max_frames="5"
    count_min="1" count_max="1"
	is_emitting="1"
	render_back="1"
    >
  </SpriteParticleEmitterComponent>

    <AudioComponent
        file="data/audio/Desktop/projectiles.bank"
        event_root="player_projectiles/bullet_disc">
    </AudioComponent>
  
    <AudioLoopComponent
        file="data/audio/Desktop/projectiles.bank"
        event_name="player_projectiles/bullet_disc/loop"
        set_speed_parameter="1"
        auto_play="1">
    </AudioLoopComponent>
    
	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/runic_sawblades/files/entities/projectiles/deck/hastium_runeblade.xml"
		>
	</VariableStorageComponent>

</Entity>
